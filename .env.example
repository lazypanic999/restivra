POSTGRES_PASSWORD=replace-with-generated-hex-password
RESTIVRA_AUTH_TOKEN=replace-with-independent-generated-access-token
RESTIVRA_INSTANCE=restivra-main
# setup generates a unique name and preserves it for subsequent Compose commands.
COMPOSE_PROJECT_NAME=restivra-example
RESTIVRA_PORT=7474
RESTIVRA_RETENTION_DAYS=30
# Optional: public HTTPS webhook. Slack and Discord URLs get chat messages, others JSON.
RESTIVRA_WEBHOOK_URL=
# Optional: 1 also notifies when a run passes but its archive is at most half its usual size.
RESTIVRA_WEBHOOK_WARNINGS=0
